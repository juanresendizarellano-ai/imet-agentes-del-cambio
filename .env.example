# ============================================================
# Storage provider — elige dónde se guardan las solicitudes
# Opciones: supabase | webhook | imet-crm
# ============================================================
STORAGE_PROVIDER=imet-crm

# --- Provider: supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Provider: webhook (para CRM: HubSpot, Zapier, Make, n8n, etc.) ---
# Descomenta y llena cuando migres al CRM:
# CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxx/yyy
# CRM_WEBHOOK_AUTH_HEADER=Bearer xxx-token-xxx

# --- Provider: imet-crm (CRM propio en api.imet.edu.mx/crm) ---
# Token de integracion (JWT con TTL largo, default 4 meses) generado desde el
# CRM por un admin via POST /api/auth/integration-token. Cuando se acerca a
# vencer, el admin regenera y reemplaza este valor.
IMET_CRM_BASE_URL=https://api.imet.edu.mx/crm
IMET_CRM_TOKEN=pega-aqui-el-jwt-generado-desde-el-crm

# --- Panel admin ---
ADMIN_PASSWORD=cambia-esta-clave-fuerte
